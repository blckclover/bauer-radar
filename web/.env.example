# Public API base URL (browser + server default)
NEXT_PUBLIC_API_URL=http://localhost:8000

# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Optional: use same-origin proxy rewrites (/api/proxy → FastAPI)
# Set to "true" on Vercel when API is private and proxied via next.config rewrites
NEXT_PUBLIC_USE_API_PROXY=false

# Mock fallback when API is offline (default off in production)
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false

# Server-only override for SSR fetches (e.g. Railway internal URL on Vercel)
# API_INTERNAL_URL=http://localhost:8000

# Proxy target for next.config rewrites (server-only, Vercel env)
# API_PROXY_TARGET=http://localhost:8000
