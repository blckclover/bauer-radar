# Gemini LLM (narrative, Red Team, analyst commentary)
GEMINI_API_KEY=

# Comma-separated allowed browser origins (include your Vercel URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Application environment
APP_ENV=development

# --- PostgreSQL (Railway production) ---
# Required on Railway. Leave empty locally to use SQLite fallback (data/app.db).
# Railway often provides: postgres://user:pass@host:5432/dbname
# DATABASE_URL=postgresql://user:password@hostname:5432/dividend_analyzer

# Local SQLite path when DATABASE_URL is unset
# SQLITE_DATABASE_PATH=data/app.db

# --- Redis (Railway production) ---
# Required on Railway for shared cache across container restarts.
# Leave empty locally to use in-memory TTL cache.
# REDIS_URL=redis://default:password@hostname:6379/0

# Analyze response cache TTL (seconds)
ENABLE_ANALYZE_CACHE=true
CACHE_TTL_SECONDS=3600

# Hunter background task retention (in-memory)
HUNTER_TASK_TTL_SECONDS=3600

# SQLAlchemy pool (PostgreSQL only)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
